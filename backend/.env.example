PROJECTS_DIR=../Projects
HTTP_TIMEOUT_SECONDS=20
REQUEST_DELAY_MS=500
MAX_CONCURRENT_SITES=4
MAX_CONCURRENT_DOWNLOADS=3
LOG_LEVEL=INFO
PLAYWRIGHT_ENABLED=true
BROWSER_PROFILE_DIR=../browser-profile
BROWSER_AUTH_ENABLED=false
SOURCE_SEARCH_TIMEOUT_SECONDS=30
DEBUG_SCRAPERS=false
DEBUG_DIR=./debug
# Set BROWSER_HEADLESS=false only for the manual browser login tool.
BROWSER_HEADLESS=true
CORS_ORIGINS=http://localhost:5173
PRINTABLES_ENABLED=true
PRINTABLES_ACCESS_MODE=auto
MAKERWORLD_ENABLED=true
MAKERWORLD_ACCESS_MODE=auto
GRABCAD_ENABLED=true
GRABCAD_ACCESS_MODE=auto
MAX_FILE_SIZE_MB=1000
